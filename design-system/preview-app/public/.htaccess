# Government Platform demo — static build, Apache (Hostinger) config.

# Hashed build assets (JS/CSS/fonts) are content-addressed and safe to
# cache forever; index.html is not hashed, so it must always revalidate.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# This demo is a single-screen app (no client-side routes), so this isn't
# load-bearing today -- it's a safety net against any accidental deep link
# or trailing path 404ing instead of loading the app.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
